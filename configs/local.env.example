# Copy to configs/local.env and edit paths. This file is sourced by Bash.

export PYTHON_BIN=/path/to/conda/env/bin/python

export YIELD_EMBEDDINGS_ROOT=/path/to/yield-embeddings
export COUNTY_PATCH_TIMESTEPS=/path/to/datasets/patches/sentinel-2-l2a
export ERA5_PATCH_TIMESTEPS=/path/to/datasets/patches/era5
export YIELD_LABELS=/path/to/datasets/labels/county_yield.csv
export S2_DAYMET_MERGED=/path/to/yield-embeddings/alpha-earth/s2_daymet_merged.xlsx
export COUNTY_FIPS_MAP=/path/to/yield-embeddings/alpha-earth/geometry.csv
export ALPHAEARTH_CSV=/path/to/benchmark-embeddings/data/alphaearth_matched.csv

# Clay requires a local official checkout and checkpoint.
export CLAY_REPO=/path/to/yield-embeddings/clay/model
export CLAY_METADATA=/path/to/yield-embeddings/clay/model/configs/metadata.yaml
export CLAY_V15_CHECKPOINT=/path/to/clay-v1.5.ckpt

# Presto loads its bundled official checkpoint from this checkout.
export PRESTO_REPO=/path/to/yield-embeddings/presto/presto

# Optional local checkpoints. Leave unset to use official registry downloads.
# export PRITHVI_CHECKPOINT=/path/to/prithvi-300m-tl.ckpt
# export TERRAMIND_6_CHECKPOINT=/path/to/terramind-base.ckpt
# export TERRAMIND_10_CHECKPOINT=/path/to/terramind-base.ckpt

export EMBEDDINGS_ROOT=/path/to/local-output/embeddings
export RESULTS_ROOT=/path/to/local-output/results
export ALPHAEARTH_OUTPUT=/path/to/local-output/embeddings/alphaearth.parquet
export COMMON_SPLIT_MANIFEST=/path/to/local-output/group_kfold_county_T7.csv

# auto selects CUDA, then Apple MPS, then CPU. Set mps to require Apple MPS.
export LOCAL_DEVICE=auto
export PYTORCH_ENABLE_MPS_FALLBACK=1
export LOCAL_NUM_WORKERS=0
export LOCAL_N_JOBS=4

# Conservative MPS extraction batches; increase after monitoring memory use.
export CLAY_BATCH_SIZE=1
export PRESTO_BATCH_SIZE=64
export PRITHVI_BATCH_SIZE=1
export TERRAMIND_BATCH_SIZE=1

export TERRAMIND_6_MODEL=terramind_v1_base
export TERRAMIND_10_MODEL=terramind_v1_base

export LOCAL_FOLDS="0 1 2 3 4"
export LOCAL_SEEDS="0 1 2"
export LOCAL_REGRESSORS="ridge random_forest xgboost ebm"
export LOCAL_RIDGE_ALPHAS="0.01 0.1 1 10 100"

export TEMPORAL_BATCH_SIZE=32
export TEMPORAL_MAX_EPOCHS=300
export TEMPORAL_PATIENCE=30

# Set FORCE=1 to overwrite/re-run completed stages, or DRY_RUN=1 to print only.
export FORCE=0
export DRY_RUN=0
